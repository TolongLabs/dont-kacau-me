{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/src/hooks/permission-request.ts",
            "timeout": 5,
            "statusMessage": "Applying your DKM policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/src/hooks/stop.ts",
            "timeout": 20,
            "statusMessage": "Updating the receipt"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/src/hooks/session-start.ts",
            "timeout": 15,
            "statusMessage": "Collecting what changed while you were away"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/src/hooks/user-prompt-submit.ts",
            "timeout": 15,
            "statusMessage": "Checking followed work items"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/src/hooks/worktree-create.ts",
            "timeout": 10,
            "statusMessage": "Binding the worktree"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/src/hooks/worktree-remove.ts",
            "timeout": 10,
            "statusMessage": "Releasing the binding"
          }
        ]
      }
    ]
  }
}
